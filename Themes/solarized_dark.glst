/* GLSL Studio Theme — Solarized Dark */

editor {
    bg: #002b36;
    fg: #839496;
    cursor: #93a1a1;
    selection: #073642;
    line-highlight: #073642;
    font-size: 14;
    line-height: 20;
}

gutter {
    bg: #002b36;
    fg: #586e75;
    border: #073642;
    width: 50;
}

preview {
    bg: #002b36;
    border: #073642;
}

toolbar {
    bg: #002b36;
    fg: #839496;
    border: #073642;
    height: 30;
}

status {
    bg: #002b36;
    fg: #93a1a1;
    error: #dc322f;
    success: #859900;
    height: 24;
}

scrollbar {
    bg: #002b36;
    thumb: #073642;
    width: 12;
}

syntax.keyword {
    color: #859900;
    bold: true;
}

syntax.type {
    color: #268bd2;
    italic: true;
}

syntax.number {
    color: #d33682;
}

syntax.string {
    color: #2aa198;
}

syntax.comment {
    color: #657b83;
    italic: true;
}

syntax.function {
    color: #b58900;
}

syntax.preprocessor {
    color: #cb4b16;
}

syntax.operator {
    color: #839496;
}

syntax.builtin {
    color: #6c71c4;
}

syntax.identifier {
    color: #839496;
}

syntax.swizzle {
    color: #93a1a1;
}

tab {
    bg: #073642;
    active-bg: #002b36;
    fg: #657b83;
    active-fg: #839496;
    border: #073642;
    height: 28;
}

node {
    bg: #073642;
    header: #0a4050;
    fg: #839496;
    border: #2aa198;
    selection: #b58900;
    shadow: #000000;
    grid-bg: #001e26;
    grid-line: #00262f;
    grid-major: #003340;
    border-radius: 6;
}

menu {
    bg: #003340;
    fg: #839496;
    hover: #073642;
    border: #2aa198;
    separator: #0a4050;
    category: #268bd2;
    shortcut: #586e75;
    shadow: #000000;
    border-radius: 8;
}

picker {
    bg: #002b36;
    fg: #839496;
    hover: #073642;
    active: #0a4050;
    border: #2aa198;
    border-radius: 10;
}

ui {
    border-radius: 4;
}
